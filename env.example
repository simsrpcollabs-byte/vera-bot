# Copy this file to .env and replace each placeholder.
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here
GUILD_ID=your_discord_server_id_here

# Optional: members with this Discord role can approve registrations.
ADMIN_ROLE_ID=

# Supabase: Project Settings > Database > Connection string > Transaction pooler.
# Replace [YOUR-PASSWORD] with the database password you created in Supabase.
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
